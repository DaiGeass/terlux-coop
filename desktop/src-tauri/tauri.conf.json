{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TerLux Coop",
  "version": "1.0.4",
  "identifier": "com.terluxcoop.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TerLux Coop · Suite Empresarial",
        "width": 1380,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://* http://*"
    },
    "trayIcon": {
      "id": "terlux-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "TerLux Coop"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 TerLux Coop",
    "category": "Business",
    "shortDescription": "Suite empresarial TerLux Coop",
    "longDescription": "Cliente de escritorio de la suite empresarial TerLux Coop: proyectos, tareas, archivos, mensajería, RRHH, dispositivos y administración, conectado por VPN privada.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Spanish", "English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
