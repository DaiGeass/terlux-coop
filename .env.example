# ============================================
# TERLUX COOP — variables de entorno (EJEMPLO)
# Copia a ".env" y cambia los secretos.
# ============================================

# Seguridad (¡obligatorio cambiarlo!)
AUTH_SECRET="cambia-este-secreto-largo"

# Base de datos (contenedor Docker: host "postgres"; local: 127.0.0.1)
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/app_db"

# App web
PORT=8443
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL="http://127.0.0.1:8443"

# MinIO / almacenamiento S3
MINIO_ENDPOINT=minio            # en Docker "minio"; local 127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER="terlux_storage"
MINIO_ROOT_PASSWORD="terlux_storage"
MINIO_BUCKET="terlux-files"

# VPN Tailscale (IP del nodo en la red 100.64.0.0/10)
TAILSCALE_IP="100.106.108.98"
TAILSCALE_NETWORK="100.64.0.0/10"